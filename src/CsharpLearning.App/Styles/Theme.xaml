<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Палитра: спокойный «учебный» тёмный режим, читаемый часами -->
    <Color x:Key="BgColor">#FF1B1D24</Color>
    <Color x:Key="BgSoftColor">#FF22252E</Color>
    <Color x:Key="CardColor">#FF272B36</Color>
    <Color x:Key="CardSoftColor">#FF2E3341</Color>
    <Color x:Key="LineColor">#FF3A4152</Color>
    <Color x:Key="TextColor">#FFE9ECF2</Color>
    <Color x:Key="TextMutedColor">#FF9AA4B8</Color>
    <Color x:Key="AccentColor">#FF56B4E9</Color>
    <Color x:Key="AccentSoftColor">#FF2C4A63</Color>
    <Color x:Key="GoodColor">#FF63C77A</Color>
    <Color x:Key="WarnColor">#FFE8B04C</Color>
    <Color x:Key="BadColor">#FFE4695F</Color>
    <Color x:Key="CodeBgColor">#FF14161D</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgSoft" Color="{StaticResource BgSoftColor}"/>
    <!-- ВАЖНО: кисти называются CardBrush/CardSoftBrush, чтобы не перекрывать
         одноимённые стили Border (Card / CardSoft) из Styles/Controls.xaml. -->
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardSoftBrush" Color="{StaticResource CardSoftColor}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Bad" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="CodeBg" Color="{StaticResource CodeBgColor}"/>

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="CodeFont">Consolas, Cascadia Mono, Courier New</FontFamily>
    <sys:Double x:Key="UiSize">14</sys:Double>
    <sys:Double x:Key="CodeSize">13</sys:Double>

    <!-- Базовые стили текста -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource UiSize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="32"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>

    <Style x:Key="H3" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
        <Setter Property="FontSize" Value="{StaticResource CodeSize}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="CodeBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#FFE4E8EF"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- подсвеченный текст под полем ввода: те же шрифт и интервал, что у TextBox -->
    <Style x:Key="CodeInput" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#FFE4E8EF"/>
        <Setter Property="LineHeight" Value="NaN"/>
    </Style>

</ResourceDictionary>
